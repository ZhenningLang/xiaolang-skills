# fig: {"content": "flow", "style": "d2-neutral", "candidates": ["d2-neutral", "d2-sketch", "im-marker"], "why": "four steps in a line with one way out; a quiet style reads best", "surface": "repo-doc"}
direction: right
cands: "1. 候选\n用户给的；缺了补一两个，\n标 [inferred]" { class: box }
dims: "2. 先定维度\n4 到 8 个，各写为什么重要；\n分不开候选的删掉" { class: new }
table: "3. 一维一行\n每格写能核对的差别，\n每行给胜者或平手" { class: box }
verdict: "4. 裁决\n选一个，写依赖什么前提、\n什么时候改选" { class: hero }
research: "候选还没定：\n先调研出候选再比较" { class: box }
cands -> dims
dims -> table
table -> verdict
cands -> research: "没定"
